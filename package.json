{
  "name": "inferno-simulator",
  "version": "0.0.1",
  "description": "Offline, self-contained OSRS Inferno simulator.",
  "private": true,
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "test": "jest",
    "test:harness": "jest --config jest.harness.config.js",
    "test:sweep": "node test/harness/sweep.js",
    "test:zuk": "jest --config jest.zuk.config.js",
    "test:zuk-sweep": "node test/harness/zukSweep.js",
    "test:wave68": "jest --config jest.wave68.config.js",
    "test:wave68-sweep": "node test/harness/wave68Sweep.js",
    "lint": "eslint . --ext .ts --fix",
    "prettier": "prettier --write ."
  },
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^27.4.1",
    "@types/lodash": "^4.14.171",
    "@types/three": "^0.163.0",
    "@typescript-eslint/eslint-plugin": "^5.17.0",
    "@typescript-eslint/parser": "^5.17.0",
    "copy-webpack-plugin": "^9.0.1",
    "eslint": "^7.32.0",
    "eslint-config-standard": "^16.0.3",
    "eslint-plugin-import": "^2.23.4",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^5.1.0",
    "html-loader": "^4.2.0",
    "jest": "^27.5.1",
    "lodash": "^4.17.21",
    "prettier": "^3.2.5",
    "ts-jest": "^27.1.4",
    "ts-loader": "^9.5.1",
    "typescript": "^4.6.3",
    "webpack": "^5.91.0",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^3.11.2"
  },
  "dependencies": {
    "osrs-sdk": "0.1.4",
    "osrscachereader": "^1.1.3",
    "three": "^0.163.0"
  }
}
